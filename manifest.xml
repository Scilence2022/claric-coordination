<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <Id>814b0af4-661b-4244-9a98-1b9a444502e6</Id>
  <Version>1.0.2.0</Version>
  <ProviderName>Claric</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Claric — AI Writing &amp; Editing Assistant for Word"/>
  <Description DefaultValue="Draft, polish, and revise documents with AI inside Word — every change lands as native tracked edits you review before anything is applied. Great for papers, theses, contracts, and everyday writing. Bring your own OpenAI-compatible model."/>
  <IconUrl DefaultValue="https://scilence2022.github.io/claric-addin/assets/icon-64.png?v=279be33d71"/>
  <HighResolutionIconUrl DefaultValue="https://scilence2022.github.io/claric-addin/assets/icon-80.png?v=279be33d71"/>
  <SupportUrl DefaultValue="https://github.com/Scilence2022/Claric/issues"/>
  <AppDomains>
    <AppDomain>api.deepseek.com</AppDomain>
    <AppDomain>open.bigmodel.cn</AppDomain>
    <AppDomain>api.moonshot.cn</AppDomain>
    <AppDomain>api.minimax.io</AppDomain>
    <AppDomain>api.minimaxi.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <!-- WordApi 1.3: table creation (insertTable, table style/headerRowCount).
       Runtime code degrades gracefully on older hosts; this declaration keeps
       the add-in installable everywhere while documenting the baseline. -->
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://scilence2022.github.io/claric-addin/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
